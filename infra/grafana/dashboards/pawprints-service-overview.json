      "id": 2,
      "targets": [
        {
          "expr": "(sum by (service) (rate(pawprints_http_requests_total{status_code=~\"5..\", route!~\"^/(healthz|readyz|metrics)$\"}[5m])) / sum by (service) (rate(pawprints_http_requests_total{route!~\"^/(healthz|readyz|metrics)$\"}[5m]))) or on(service) (0 * sum by (service) (rate(pawprints_http_requests_total{route!~\"^/(healthz|readyz|metrics)$\"}[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "title": "5xx Ratio",
